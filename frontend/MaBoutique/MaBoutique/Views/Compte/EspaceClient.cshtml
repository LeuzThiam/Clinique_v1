@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model dynamic

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Espace Client";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Bienvenue dans votre espace client</h2>
        <p class="text-muted">
            Gérez vos commandes, votre panier, vos factures et vos informations personnelles.
        </p>
    </div>

    <div class="row justify-content-center">
        <!-- Mes Commandes -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-bag-check-fill display-4 text-primary mb-3"></i>
                    <h5 class="card-title">Mes Commandes</h5>
                    <p class="card-text small">
                        Consultez l'historique de vos commandes et suivez vos livraisons.
                    </p>
                    <a asp-controller="Commandes" asp-action="Historique" class="btn btn-outline-primary btn-sm">
                        Voir mes commandes
                    </a>
                </div>
            </div>
        </div>

        <!-- Mon Panier -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-cart display-4 text-warning mb-3"></i>
                    <h5 class="card-title">Mon Panier</h5>
                    <p class="card-text small">
                        Accédez à votre panier pour consulter et modifier vos articles.
                    </p>
                    <a asp-controller="Panier" asp-action="Index" class="btn btn-outline-warning btn-sm">
                        Voir mon panier
                    </a>
                </div>
            </div>
        </div>

        <!-- Mes Factures -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-receipt-cutoff display-4 text-success mb-3"></i>
                    <h5 class="card-title">Mes Factures</h5>
                    <p class="card-text small">
                        Accédez et téléchargez vos factures en toute simplicité.
                    </p>
                    <a asp-controller="Factures" asp-action="Index" class="btn btn-outline-success btn-sm">
                        Voir mes factures
                    </a>
                </div>
            </div>
        </div>

        <!-- Mon Profil -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-person-lines-fill display-4 text-secondary mb-3"></i>
                    <h5 class="card-title">Mes Informations</h5>
                    <p class="card-text small">
                        Modifiez vos informations personnelles et votre mot de passe.
                    </p>
                    <a asp-controller="Compte" asp-action="Profil" class="btn btn-outline-secondary btn-sm">
                        Accéder à mon profil
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
